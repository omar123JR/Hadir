# Dependency directories
**/node_modules/

# Production build artifacts
**/dist/
**/build/
**/out/
**/.next/

# Environment files (sensitive credentials)
**/.env
**/.env.local
**/.env.development.local
**/.env.test.local
**/.env.production.local
**/*.env

# Uploads and temporary files
**/uploads/*
!**/uploads/.gitkeep
**/temp/
**/tmp/

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS-specific files
.DS_Store
Thumbs.db

# Security / Certificates
*.pem
*.key
*.p12
*.pfx
!.env.example
