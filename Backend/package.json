{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "dev": "ts-node-dev -r dotenv/config --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "ts-node -r dotenv/config src/scripts/seedDatabase.ts",
    "test:setup": "ts-node tests/setupTestDB.ts",
    "test:security": "jest",
    "backup:db": "ts-node -r dotenv/config src/scripts/backup-db.ts",
    "backup:storage": "ts-node -r dotenv/config src/scripts/backup-storage.ts",
    "backup:verify": "ts-node -r dotenv/config src/scripts/verify-backup.ts",
    "backup:cleanup": "ts-node -r dotenv/config src/scripts/cleanup-backups.ts",
    "generate-sbom": "ts-node src/scripts/generate-sbom.ts",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "npm run test:security"
    ]
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.5.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "mysql2": "^3.16.0",
    "tar": "^7.5.15",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.3",
    "@types/supertest": "^7.2.0",
    "@types/tar": "^6.1.13",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "lint-staged": "^17.0.5",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
