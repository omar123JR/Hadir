# Environment Configuration
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Database Configuration
DB_HOST=your_db_host_here
DB_PORT=3306
DB_USER=your_db_user_here
DB_PASSWORD=your_secure_db_password_here
DB_NAME=your_db_name_here

# JWT Configuration
# MUST be at least 32 characters long and cryptographically random in production!
JWT_SECRET=your_secure_random_string_of_at_least_32_characters_here
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Proxy Configuration (REQUIRED in production if running behind Nginx/Cloudflare)
# TRUST_PROXY=1

# JWT Refresh Secret
JWT_REFRESH_SECRET=your_secure_random_refresh_secret_at_least_32_chars_here

# Backup Encryption (Phase 11)
# Optional: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# BACKUP_ENCRYPTION_KEY=your_64_char_hex_encryption_key_here

# Security Alerting (Phase 12)
# Optional: Discord and/or Slack webhook URLs for real-time security alerts
# ALERT_DISCORD_WEBHOOK=https://discord.com/api/webhooks/your_webhook_id/your_webhook_token
# ALERT_SLACK_WEBHOOK=https://hooks.slack.com/services/your/slack/webhook
